# Postgres (Neon, Supabase, Railway...). Em Neon/Supabase use a URL "pooled" aqui
DATABASE_URL="postgresql://usuario:senha@host:5432/pelada"
# URL direta (sem pooler) usada pelas migrations
DIRECT_URL="postgresql://usuario:senha@host:5432/pelada"
# URL pública do app (links de convite e recuperação de senha)
APP_URL="http://localhost:3000"
# Opcional: envio real de e-mail (recuperação de senha) via Resend
RESEND_API_KEY=""
MAIL_FROM="Pelada <nao-responda@seudominio.com>"

# Google Maps (opcional). Sem estas chaves o app usa o mapa gratuito (CARTO + OpenStreetMap).
# O app para de usar o Google perto da cota grátis do mês (src/lib/google.ts) e volta ao mapa gratuito.
NEXT_PUBLIC_GOOGLE_MAPS_KEY="" # chave do mapa, restrita aos domínios do site e à Maps JavaScript API
GOOGLE_PLACES_KEY=""           # chave das quadras, só no servidor, restrita à Places API (New)
